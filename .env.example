# =============================================
# Intership Frontend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================

# Supabase (ANON key only - safe for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API
VITE_API_URL=http://localhost:3001/api

# Razorpay (public key only - safe for frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Google Form for student registration
VITE_GOOGLE_FORM_URL=https://forms.google.com/your-form-url

# WhatsApp sharing text ({FORM_URL} will be replaced with VITE_GOOGLE_FORM_URL)
VITE_WHATSAPP_SHARE_TEXT=Students looking for internships can register with Intership here: {FORM_URL}. Opportunities available in web development, app development, VLSI, embedded systems and many more fields. Visit intership.in

# App metadata
VITE_APP_NAME=Intership
VITE_APP_URL=https://intership.in
